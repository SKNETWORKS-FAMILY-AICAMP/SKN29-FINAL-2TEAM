DJANGO_SETTINGS_MODULE=config.settings.local
SECRET_KEY=change-this-before-shared-development
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# DATABASE_URL 은 이 파일 아래쪽 「DATABASE_URL」 블록에서 정한다. 여기서 정하지 않는다.
CORS_ALLOWED_ORIGINS=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000/api
FRONTEND_BASE_URL=http://localhost:5173
SECURE_SSL_REDIRECT=False

# Google Drive OAuth 웹 애플리케이션 자격증명. 실제 값은 Git에 넣지 않는다.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:8000/api/connectors/google-drive/callback/
# ⚠ **로컬에서는 Jira 연결이 안 된다**(2026-08-14~). Atlassian 3LO 는 앱마다
# Callback URL 을 하나만 받는데, 그 하나를 AWS 주소로 넘겼기 때문이다.
# 아래 주소로 시도하면 Atlassian 이 redirect_uri_mismatch 를 낸다 —
# 설정이 틀린 게 아니라 그렇게 하기로 한 것이다. 자세한 이유는
# docs/개발환경/AWS_이전_매뉴얼.md §1 참고.
# 로컬에서 Jira 를 봐야 하면 개발자 콘솔에 앱을 하나 더 만들어 그 값을 넣는다.
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
JIRA_REDIRECT_URI=http://localhost:8000/api/connectors/jira/callback/

# 메일(비밀번호 재설정 링크 전용).
# 비워 두면 console 백엔드로 동작해서 메일 본문이 터미널에 출력된다 — 개발 중에는 이대로 두면 된다.
# 실제로 발송하려면 아래 주석을 풀고 Gmail 앱 비밀번호를 넣는다.
# 앱 비밀번호는 2단계 인증을 켠 계정에서만 발급된다(계정 비밀번호로는 SMTP 로그인이 막혀 있다).
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST_USER=운영자@gmail.com
# EMAIL_HOST_PASSWORD=앱-비밀번호-16자리
# DEFAULT_FROM_EMAIL=halil <운영자@gmail.com>

# ── 문서 파싱·임베딩 파이프라인(RunPod Serverless) ────────────────────
# `config/settings/base.py`가 읽는다. 비밀·주소에는 운영용 기본값을 두지 않으며,
# 실제로 필요한 지점에서 검증한다. 설정 근거는
# docs/Agent/RunPod_Serverless_배포_인수인계.md 에 있다.

# Endpoint ID는 비밀이 아니지만 사람마다 다른 Endpoint를 쓸 수 있어 비워 둔다.
# 팀 공용 값은 위 인수인계 문서 2장에 적혀 있다.
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=

# RunPod가 원문을 받아 가는 Django의 HTTPS 주소. 반드시 HTTPS여야 하고,
# localhost는 RunPod에서 닿지 않는다.
#
# **로컬**: Cloudflare Quick Tunnel 주소를 넣는다. 재실행할 때마다 바뀌므로
#   그때마다 여기를 고치고 컨테이너를 재생성한다(restart로는 반영되지 않는다).
#   같은 호스트를 ALLOWED_HOSTS 에도 넣는다.
# **AWS**: `https://api.halil-ai.site` 로 고정이다. 터널이 필요 없다.
PUBLIC_BACKEND_BASE_URL=
RUNPOD_JOB_TTL_MS=3600000
RUNPOD_EXECUTION_TIMEOUT_MS=1800000
DOCUMENT_DOWNLOAD_TOKEN_MAX_AGE_SECONDS=900
# 질의 임베딩이 워커 콜드 스타트를 기다리는 한도(초).
RUNPOD_EMBED_WAIT_SECONDS=600

# EmbeddingGemma 이용 약관에 동의한 계정의 토큰이어야 모델이 받아진다.
HF_TOKEN=
OPENAI_API_KEY=

# 웹 검색(Tavily — https://tavily.com, 무료 티어 있음).
# **없으면 web_search 도구만 안 돈다.** 다른 기능은 그대로이고, 에이전트가
# "웹 검색이 설정되지 않았습니다"라고 정직하게 말한다 — 조용히 빈 결과를 주면
# 「찾아봤는데 없다」와 「찾아보지도 않았다」를 구별할 수 없다.
WEB_SEARCH_API_KEY=

# 아래 넷은 편의를 위한 기본값이 아니라 교차 시스템 계약이다. 다른 값이 들어오면
# 조용히 바꿔 실행하지 않고 실패하도록 구현돼 있다.
# 청킹 토큰 계산과 임베딩이 같은 모델을 써야 차원과 길이 기준이 어긋나지 않는다.
# 검색어 생성 전용. 같은 일에 Sol 은 Luna 의 수백 배가 든다(실측).
# auto · default · flex · scale · priority · fast. priority 는 대기열을 앞당기는
# 대신 요금이 올라간다. 계정에 열려 있지 않으면 요청이 거절된다.
OPENAI_SERVICE_TIER=auto
EMBEDDING_MODEL=google/embeddinggemma-300m
EMBEDDING_DEVICE=cuda
CHUNKING_MAX_TOKENS=512
CHUNKING_MERGE_PEERS=true

# ---------------------------------------------------------------------------
# DATABASE_URL — **둘 중 하나만 채운다.**
#
# ⚠ 2026-08-12 부터 `docker-compose.yml` 이 이 값을 덮어쓰지 않는다(AWS 이전).
#    그전에는 compose 의 `environment:` 가 `@db:5432` 로 강제하고 있어서 이 파일에
#    무엇이 들어 있든 상관없었다. 이제는 **이 값이 그대로 쓰인다.**
#
#    그래서 옛 로컬 값(`@127.0.0.1:5432`)을 그대로 두면 컨테이너가 **자기 자신**에
#    붙으려다 실패한다 — 증상은 `/api/health` 503 이고 원인 메시지가 안 나온다.
#
#   ※ 사용자·DB 이름이 `project_copilot` 인 것은 halil 이전의 제품명이 남은
#      것이다. **일부러 그대로 둔다** — 바꾸면 팀원 전원이 로컬 볼륨을 버리고
#      DB 를 다시 만들어야 하고, 공유 AWS RDS 와 각자의 .env 도 함께 깨진다.
#      이름이 하는 일은 없으므로 비용만 있고 이득이 없다(2026-08-13).
#
#   ① 로컬 Postgres 컨테이너를 쓸 때  → 호스트 이름이 `db` 다(127.0.0.1 아님)
#      DATABASE_URL=postgres://project_copilot:project_copilot@db:5432/project_copilot
#   ② 팀 공유 AWS RDS 를 쓸 때        → 아래에 RDS 주소를 넣는다
# ---------------------------------------------------------------------------
DATABASE_URL=

# ---------------------------------------------------------------------------
# S3 관련 키
#
# ✅ **배선됐다 (2026-08-18).** `backend/services/storage.py` 가
#    `OBJECT_STORAGE_PROVIDER` 를 보고 `local`·`s3` 로 갈린다. `s3` 로 두면
#    원문이 버킷에 올라간다.
#
#    ⚠ **키는 여기에 안 넣어도 된다.** boto3 가 알아서 찾는다 — EC2 에서는
#    인스턴스 역할이, 로컬에서는 아래 두 값이 잡힌다. 서버에 역할을 붙였다면
#    아래 둘은 **비워 두는 쪽이 맞다.**
#
#    ⚠ **갈아탄다고 옛 파일이 따라오지 않는다.** 로컬에 쌓인 원문은 버킷에
#    없다. 커넥터 문서는 다시 받으면 되지만(우리는 사본이다), 사용자가 올린
#    파일은 **원본이 우리뿐**이라 옮기지 않으면 사라진다.
# ---------------------------------------------------------------------------
OBJECT_STORAGE_PROVIDER=s3
AWS_STORAGE_BUCKET_NAME=skn29-final-2team-files-nm0p
AWS_S3_REGION_NAME=ap-northeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Claude 계열을 쓰려면 필요하다. OpenAI 호환 경로를 쓰므로 별도 SDK 는 없다.
# 실제 값은 .env 에만 넣는다 — 이 파일은 추적된다.
ANTHROPIC_API_KEY=

# ── 운영자 콘솔(/ops/login) ────────────────────────────────────────
# `backend/services/createDB/seed_ops_admin.py` 가 읽는다. 로그인 코드는 이 값을
# 보지 않는다 — 스크립트가 계정 행을 만들 뿐이라 승격 경로는 여전히 API 밖이다.
# `reset_demo.sql` 로 계정을 다 비운 뒤 운영자로 다시 들어가려고 쓴다.
# ⚠ 기본값을 두지 않는다. 비면 스크립트가 그냥 실패한다.
OPS_ADMIN_EMAIL=
OPS_ADMIN_PASSWORD=
