{
  "rest": {
    "RestGenerator": {
      "name": "isolated evaluation endpoint",
      "uri": "http://host.docker.internal:8000/eval-only/generate",
      "method": "post",
      "headers": {
        "Authorization": "Bearer $KEY"
      },
      "req_template_json_object": {
        "prompt": "$INPUT"
      },
      "response_json": true,
      "response_json_field": "text",
      "request_timeout": 60
    }
  }
}
