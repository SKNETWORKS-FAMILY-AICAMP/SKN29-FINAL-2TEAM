# 정적 빌드를 서빙한다(`Dockerfile` 의 `static` 스테이지). 앞단 Caddy 가
# TLS 를 이미 끝냈으므로 여기서는 평문 http 만 받는다.
:5173 {
	root * /srv

	# ⚠ 이 줄이 없으면 **새로고침할 때만** 404 가 난다. 라우팅이 브라우저 쪽에
	# 있어서 `/settings/team` 같은 주소에 해당하는 파일이 서버에 없기 때문이다.
	# 링크를 눌러 이동할 때는 멀쩡해서 늦게 발견된다.
	try_files {path} /index.html

	file_server

	# 해시가 붙은 자산은 내용이 바뀌면 이름이 바뀌므로 오래 캐시해도 안전하다.
	@hashed path /assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	# **나머지는 매번 물어본다.** `index.html` 에 헤더가 없으면 브라우저가
	# 스스로 캐시 기간을 **추측한다**(Last-Modified 로부터 경과한 시간의 10%
	# 정도가 관행이다). 그러면 배포한 뒤 새로고침해도 옛 `index.html` 이 나오고,
	# 그것이 가리키는 옛 해시 자산은 `immutable` 이라 더 확실히 캐시돼 있어서
	# **화면이 통째로 예전 것으로 남는다.** 2026-08-18 QA 에서 실제로 겪었다 —
	# 고친 것이 안 먹은 줄 알고 코드를 다시 봤다. 시연 중에 나면 원인을 못 찾는다.
	#
	# 매처를 `path /index.html` 로 걸지 않는 이유: Caddy 는 `header` 를
	# **`try_files` 보다 먼저** 실행해서, `/chat` 같은 주소는 아직 다시 쓰이기
	# 전이라 그 매처에 안 걸린다. 그래서 「해시 자산이 아닌 것 전부」로 뒤집는다.
	#
	# `no-store` 가 아니라 `no-cache` 다 — 받아 두되 쓰기 전에 반드시 물어본다는
	# 뜻이라, 안 바뀌었으면 `304`(본문 없음)로 끝난다. 매번 새로 받지 않는다.
	@revalidate not path /assets/*
	header @revalidate Cache-Control "no-cache"
}
